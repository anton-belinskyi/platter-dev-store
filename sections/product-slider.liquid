{%- liquid
  assign list_id = 'ProductSliderList-' | append: section.id
  assign heading_id = 'ProductSliderHeading-' | append: section.id
  assign has_more = false
  if section.blocks.size > 4
    assign has_more = true
  endif
-%}

<script src="{{ 'product-slider.js' | asset_url }}" type="module"></script>
<script src="{{ 'product-reveal.js' | asset_url }}" type="module"></script>

<section
  class="product-slider section-inset section-padding overflow-x-clip bg-white font-sans tracking-normal text-primary antialiased"
  style="
    --section-padding-top: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-md: {{ section.settings.padding_top }}px;
    --section-padding-bottom-md: {{ section.settings.padding_bottom }}px;
  "
  {% if section.settings.heading != blank %}aria-labelledby="{{- heading_id -}}"{% endif %}
>
  <header class="flex items-center justify-center md:justify-between">
    {%- if section.settings.heading != blank -%}
      <h2 id="{{ heading_id }}" class="font-serif text-heading font-bold md:text-heading-lg md:font-black">
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}

    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <a
        href="{{ section.settings.link_url }}"
        class="group hidden items-center gap-2 rounded-full px-8 py-4 text-link font-semibold text-secondary focus-visible:outline-2 focus-visible:outline-secondary md:inline-flex!"
      >
        {{- section.settings.link_label | escape -}}
        <svg class="size-5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M3.33 10h13.34m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    {%- endif -%}
  </header>

  <product-reveal class="mt-6 block md:mt-9" {% if has_more %}data-collapsed{% endif %}>
    <product-slider class="block">
      <ul id="{{- list_id -}}" class="product-grid gap-x-2.75 gap-y-3 md:slider-track" data-slider-track>
        {%- for block in section.blocks -%}
          {%- render 'product-slider-card', block: block, index: forloop.index0 -%}
        {%- endfor -%}
      </ul>

      <div class="group/bar relative mt-10 -mb-2 hidden cursor-pointer touch-none items-center py-2 md:flex!" aria-hidden="true" data-slider-bar>
        <span class="block h-1 w-full rounded-md bg-scrollbar-track"></span>
        <span class="absolute left-0 block h-1 rounded-md bg-scrollbar-thumb transition-[height] duration-200 group-hover/bar:h-1.5 group-data-active/bar:h-1.5" data-slider-thumb></span>
      </div>
    </product-slider>

    {%- if has_more -%}
      <button
        type="button"
        class="mt-3 flex w-full items-center justify-center rounded-full bg-primary px-6 py-4 text-button font-semibold text-contrast transition-colors hover:bg-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:hidden!"
        aria-expanded="false"
        aria-controls="{{- list_id -}}"
        data-reveal-button
        data-label-expand="{{- 'sections.product_slider.show_more' | t -}}"
        data-label-collapse="{{- 'sections.product_slider.show_less' | t -}}"
      >
        {{- 'sections.product_slider.show_more' | t -}}
      </button>
    {%- endif -%}
  </product-reveal>
</section>

{% schema %}
{
  "name": "t:sections.product_slider.name",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Best Sellers",
      "label": "t:sections.product_slider.settings.heading.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "default": "Shop All Best Sellers",
      "label": "t:sections.product_slider.settings.link_label.label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:sections.product_slider.settings.link_url.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product_slider.settings.padding_top_mobile.label",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product_slider.settings.padding_bottom_mobile.label",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.product_slider.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.product_slider.blocks.product.settings.product.label"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "t:sections.product_slider.blocks.product.settings.hover_image.label",
          "info": "t:sections.product_slider.blocks.product.settings.hover_image.info"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "t:sections.product_slider.presets.name",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
